rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 익명 로그인을 포함해 로그인한 요청만 읽고 쓸 수 있다.
    // 가입 암호가 공용이므로 사용자 간 격리는 하지 않는다 (docs/05 참조).
    match /n2users/{name} {
      allow read, write: if request.auth != null;
    }
    match /n2ranking/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
